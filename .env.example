# Default student analysis: the GPU service is accessed through a loopback SSH tunnel.
ENERGY_AGENT_STUDENT_FOCUSED_ENABLED=1
ENERGY_AGENT_STUDENT_FOCUSED_URL=http://127.0.0.1:28081
ENERGY_AGENT_STUDENT_FOCUSED_TIMEOUT_S=60
# ENERGY_AGENT_STUDENT_FOCUSED_TOKEN_FILE=<private local token file>

# Optional external provider, used only after explicit selection in the page.
# Set these variables in the process that starts uvicorn.
# This example file is documentation; it is not loaded automatically.
ENERGY_AGENT_LLM_BASE_URL=https://your-provider.example/compatible-mode/v1
ENERGY_AGENT_LLM_MODEL=your-enabled-model
ENERGY_AGENT_LLM_API_KEY=
